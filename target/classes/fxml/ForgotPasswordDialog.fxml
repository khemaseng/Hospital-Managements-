<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.ForgotPasswordController" spacing="16" prefWidth="400">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Reset Password" styleClass="section-title"/>
    <Label text="Enter your username and we'll generate a temporary password. Since this desktop app has no email server, it will be shown here once - use it to sign in, then set a new password from My Profile."
           wrapText="true" styleClass="muted" style="-fx-font-size: 12px;"/>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>
    <Label fx:id="resultLabel" wrapText="true" managed="false" visible="false" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

    <VBox spacing="4">
        <Label text="Username" styleClass="muted"/>
        <TextField fx:id="usernameField" promptText="Enter your username"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" styleClass="btn-secondary" onAction="#handleClose"/>
        <Button fx:id="resetButton" text="Reset Password" styleClass="btn-primary" onAction="#handleReset"/>
    </HBox>
</VBox>
