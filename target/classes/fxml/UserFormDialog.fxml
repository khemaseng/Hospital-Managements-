<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.UserFormController" spacing="16" prefWidth="440">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Add User Account" styleClass="section-title"/>
    <Label fx:id="formErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
            <Label text="Full Name *" styleClass="muted"/>
            <TextField fx:id="fullNameField"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Username *" styleClass="muted"/>
            <TextField fx:id="usernameField"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Role *" styleClass="muted"/>
            <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
            <Label text="Email *" styleClass="muted"/>
            <TextField fx:id="emailField"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
            <Label text="Password * (min 6 characters)" styleClass="muted"/>
            <PasswordField fx:id="passwordField"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Create Account" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
