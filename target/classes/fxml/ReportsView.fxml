<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.ReportsController" spacing="20">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Range:" styleClass="muted"/>
        <fx:define>
            <ToggleGroup fx:id="rangeGroup"/>
        </fx:define>
        <ToggleButton fx:id="dailyToggle" text="Daily" styleClass="btn-secondary" toggleGroup="$rangeGroup" onAction="#handleRangeChanged"/>
        <ToggleButton fx:id="weeklyToggle" text="Weekly" styleClass="btn-secondary" toggleGroup="$rangeGroup" onAction="#handleRangeChanged"/>
        <ToggleButton fx:id="monthlyToggle" text="Monthly" styleClass="btn-secondary" toggleGroup="$rangeGroup" onAction="#handleRangeChanged" selected="true"/>
        <ToggleButton fx:id="yearlyToggle" text="Yearly" styleClass="btn-secondary" toggleGroup="$rangeGroup" onAction="#handleRangeChanged"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export to Excel (.xlsx)" styleClass="btn-secondary" onAction="#handleExportExcel"/>
        <Button text="Export Summary (.txt)" styleClass="btn-secondary" onAction="#handleExport"/>
    </HBox>

    <GridPane hgap="18" vgap="18">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox styleClass="card" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="APPOINTMENTS IN RANGE" styleClass="card-title"/>
            <Label fx:id="appointmentsInRangeLabel" text="0" styleClass="card-value"/>
        </VBox>
        <VBox styleClass="card" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="REVENUE IN RANGE" styleClass="card-title"/>
            <Label fx:id="revenueInRangeLabel" text="\$0" styleClass="card-value"/>
        </VBox>
    </GridPane>

    <GridPane hgap="18" vgap="18" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="55"/>
            <ColumnConstraints percentWidth="45"/>
        </columnConstraints>

        <VBox styleClass="card" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Appointments by Department" style="-fx-font-weight: bold;"/>
            <BarChart fx:id="departmentChart" legendVisible="false" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis fx:id="departmentAxis"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="departmentValueAxis"/>
                </yAxis>
            </BarChart>
        </VBox>

        <VBox styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Appointment Status Breakdown" style="-fx-font-weight: bold;"/>
            <PieChart fx:id="statusChart" VBox.vgrow="ALWAYS"/>
        </VBox>
    </GridPane>
</VBox>
