<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.AuditLogController" spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Recent system activity: logins, deletions, and key changes." styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
    </HBox>

    <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTime" text="Time" prefWidth="160"/>
            <TableColumn fx:id="colUser" text="User" prefWidth="140"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="200"/>
            <TableColumn fx:id="colDetails" text="Details" prefWidth="320"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>
