

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.AppointmentController" spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by patient, doctor, or code..." prefWidth="280" onKeyReleased="#handleFilterChanged"/>
        <ComboBox fx:id="statusFilter" promptText="Status" onAction="#handleFilterChanged"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" styleClass="muted"/>
        <Button text="+ Book Appointment" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="appointmentTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCode" text="Appt ID" minWidth="90" prefWidth="95"/>
            <TableColumn fx:id="colPatient" text="Patient" minWidth="130" prefWidth="140"/>
            <TableColumn fx:id="colDoctor" text="Doctor" minWidth="130" prefWidth="140"/>
            <TableColumn fx:id="colDepartment" text="Department" minWidth="110" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Date" minWidth="95" prefWidth="100"/>
            <TableColumn fx:id="colTime" text="Time" minWidth="85" prefWidth="90"/>
            <TableColumn fx:id="colStatus" text="Status" minWidth="105" prefWidth="110"/>
            <TableColumn fx:id="colActions" text="Actions" minWidth="300" prefWidth="310"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>