<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.AppointmentFormController" spacing="16" prefWidth="480">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Book Appointment" styleClass="section-title"/>
    <Label fx:id="formErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient *" styleClass="muted"/>
            <ComboBox fx:id="patientCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Doctor *" styleClass="muted"/>
            <ComboBox fx:id="doctorCombo" maxWidth="Infinity" onAction="#handleDoctorChanged"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Department" styleClass="muted"/>
            <Label fx:id="departmentValueLabel" text="-" style="-fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Consultation Fee" styleClass="muted"/>
            <Label fx:id="feeValueLabel" text="-" style="-fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Date *" styleClass="muted"/>
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Time *" styleClass="muted"/>
            <ComboBox fx:id="timeCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
            <Label text="Reason for Visit" styleClass="muted"/>
            <TextArea fx:id="reasonField" prefRowCount="2" wrapText="true"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Book Appointment" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
