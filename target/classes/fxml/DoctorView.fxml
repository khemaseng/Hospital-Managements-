<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.DoctorController" spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by name, ID, or specialization..." prefWidth="300" onKeyReleased="#handleFilterChanged"/>
        <ComboBox fx:id="departmentFilter" promptText="Department" onAction="#handleFilterChanged"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" styleClass="muted"/>
        <Button text="Export to Excel" styleClass="btn-secondary" onAction="#handleExportExcel"/>
        <Button text="+ Add Doctor" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" text="Doctor ID" prefWidth="90"/>
            <TableColumn fx:id="colName" text="Full Name" prefWidth="150"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="120"/>
            <TableColumn fx:id="colSpecialization" text="Specialization" prefWidth="160"/>
            <TableColumn fx:id="colPhone" text="Phone" prefWidth="110"/>
            <TableColumn fx:id="colFee" text="Fee" prefWidth="70"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="160"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>

    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="prevPageButton" text="Previous" styleClass="btn-secondary" onAction="#handlePrevPage"/>
        <Label fx:id="pageInfoLabel" styleClass="muted" text="Page 1 of 1"/>
        <Button fx:id="nextPageButton" text="Next" styleClass="btn-secondary" onAction="#handleNextPage"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Rows per page:" styleClass="muted"/>
        <ComboBox fx:id="pageSizeCombo" onAction="#handlePageSizeChanged"/>
    </HBox>
</VBox>
