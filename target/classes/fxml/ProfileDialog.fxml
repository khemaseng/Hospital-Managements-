<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.ProfileController" spacing="18" prefWidth="420">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="My Profile" styleClass="section-title"/>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <ImageView fx:id="avatarPreview" fitWidth="72" fitHeight="72"/>
        <VBox spacing="6">
            <Label fx:id="nameLabel" text="Name" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
            <Label fx:id="roleLabel" text="Role" styleClass="muted"/>
            <Button text="Change Photo..." styleClass="btn-secondary" onAction="#handleChoosePhoto"/>
        </VBox>
    </HBox>

    <Label fx:id="avatarErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <Separator/>

    <VBox spacing="10">
        <Label text="Change Password" style="-fx-font-weight: bold;"/>
        <Label fx:id="passwordErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

        <VBox spacing="4">
            <Label text="Current Password" styleClass="muted"/>
            <PasswordField fx:id="currentPasswordField"/>
        </VBox>
        <VBox spacing="4">
            <Label text="New Password (min 6 characters)" styleClass="muted"/>
            <PasswordField fx:id="newPasswordField"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Confirm New Password" styleClass="muted"/>
            <PasswordField fx:id="confirmPasswordField"/>
        </VBox>
        <Button text="Update Password" styleClass="btn-secondary" onAction="#handleChangePassword" maxWidth="Infinity"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" styleClass="btn-primary" onAction="#handleClose"/>
    </HBox>
</VBox>
