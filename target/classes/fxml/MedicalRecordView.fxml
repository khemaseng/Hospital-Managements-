


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.MedicalRecordController" spacing="16">
    <!-- Top Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by patient, doctor, or diagnosis..." prefWidth="270" onKeyReleased="#handleFilterChanged"/>
        <ComboBox fx:id="doctorFilter" promptText="Doctor" prefWidth="160" onAction="#handleFilterChanged"/>
        <ComboBox fx:id="sortFilter" promptText="Sort By" prefWidth="160" onAction="#handleFilterChanged"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" styleClass="muted"/>
        <Button text="+ Add Record" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>
    <TableView fx:id="recordTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colDate" text="Date" minWidth="100" prefWidth="110"/>
            <TableColumn fx:id="colPatient" text="Patient" minWidth="130" prefWidth="150"/>
            <TableColumn fx:id="colDoctor" text="Doctor" minWidth="130" prefWidth="150"/>
            <TableColumn fx:id="colDiagnosis" text="Diagnosis" minWidth="180" prefWidth="220"/>
            <TableColumn fx:id="colPrescription" text="Prescription" minWidth="180" prefWidth="220"/>
            <TableColumn fx:id="colActions" text="Actions" minWidth="150" prefWidth="160" styleClass="col-center"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>