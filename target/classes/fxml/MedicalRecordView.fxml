<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.MedicalRecordController" spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by patient, doctor, or diagnosis..." prefWidth="320" onKeyReleased="#handleFilterChanged"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" styleClass="muted"/>
        <Button text="+ Add Record" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="recordTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colPatient" text="Patient" prefWidth="150"/>
            <TableColumn fx:id="colDoctor" text="Doctor" prefWidth="150"/>
            <TableColumn fx:id="colDiagnosis" text="Diagnosis" prefWidth="200"/>
            <TableColumn fx:id="colPrescription" text="Prescription" prefWidth="200"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="160"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>
