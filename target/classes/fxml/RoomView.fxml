

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.RoomController" spacing="16">

    <!-- Top Filter & Search Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by room, floor, or notes..." prefWidth="250" onKeyReleased="#handleFilterChanged"/>

        <!-- Room Type Filter -->
        <ComboBox fx:id="typeFilter" promptText="Room Type" prefWidth="160" minWidth="150" onAction="#handleFilterChanged"/>

        <!-- Availability / Status Filter -->
        <ComboBox fx:id="availabilityFilter" promptText="Availability" prefWidth="140" minWidth="130" onAction="#handleFilterChanged"/>

        <!-- Sorting Dropdown -->
        <ComboBox fx:id="sortFilter" promptText="Sort By" prefWidth="170" minWidth="160" onAction="#handleFilterChanged"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="occupancySummaryLabel" styleClass="muted"/>
        <Button text="+ Add Room" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <!-- Table View -->
    <TableView fx:id="roomTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCode" text="Room" minWidth="90" prefWidth="100"/>
            <TableColumn fx:id="colType" text="Type" minWidth="140" prefWidth="150"/>
            <TableColumn fx:id="colFloor" text="Floor" minWidth="80" prefWidth="90"/>
            <TableColumn fx:id="colOccupancy" text="Occupancy" minWidth="110" prefWidth="120" styleClass="col-center"/>
            <TableColumn fx:id="colNotes" text="Notes" minWidth="200" prefWidth="240"/>
            <TableColumn fx:id="colActions" text="Actions" minWidth="150" prefWidth="160" styleClass="col-center"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>