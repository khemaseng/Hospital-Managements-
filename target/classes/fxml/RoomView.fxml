<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.RoomController" spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Rooms and beds available across the hospital." styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="occupancySummaryLabel" styleClass="muted"/>
        <Button text="+ Add Room" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="roomTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" text="Room" prefWidth="100"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
            <TableColumn fx:id="colFloor" text="Floor" prefWidth="100"/>
            <TableColumn fx:id="colOccupancy" text="Occupancy" prefWidth="120"/>
            <TableColumn fx:id="colNotes" text="Notes" prefWidth="220"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="160"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>
