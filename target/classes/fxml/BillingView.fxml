<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.BillingController" spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by patient or invoice code..." prefWidth="300" onKeyReleased="#handleFilterChanged"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalRevenueLabel" styleClass="muted"/>
        <Button text="Export to Excel" styleClass="btn-secondary" onAction="#handleExportExcel"/>
        <Button text="+ New Invoice" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="invoiceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" text="Invoice ID" prefWidth="100"/>
            <TableColumn fx:id="colPatient" text="Patient" prefWidth="160"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="90"/>
            <TableColumn fx:id="colDiscount" text="Discount" prefWidth="80"/>
            <TableColumn fx:id="colTax" text="Tax" prefWidth="70"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="90"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="220"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>
