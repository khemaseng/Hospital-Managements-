<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.RoomAssignController" spacing="16" prefWidth="420">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label fx:id="titleLabel" text="Room Assignment" styleClass="section-title"/>
    <Label fx:id="formErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <VBox spacing="4">
        <Label text="Current Status" styleClass="muted"/>
        <Label fx:id="currentStatusLabel" text="Not admitted" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Assign to Available Room" styleClass="muted"/>
        <ComboBox fx:id="roomCombo" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="dischargeButton" text="Discharge" styleClass="btn-danger" onAction="#handleDischarge"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" styleClass="btn-secondary" onAction="#handleClose"/>
        <Button fx:id="admitButton" text="Admit to Room" styleClass="btn-primary" onAction="#handleAdmit"/>
    </HBox>
</VBox>
