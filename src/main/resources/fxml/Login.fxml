<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.canvas.Canvas?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hms.controller.LoginController"
           styleClass="login-root" prefWidth="1000" prefHeight="680">

    <!-- ============ HOSPITAL BLUEPRINT BACKGROUND ============
         Drawn programmatically in LoginController (grid + simplified
         isometric building blocks) rather than an image asset, so it
         scales cleanly to any window size with no external file to ship. -->
    <Canvas fx:id="backgroundCanvas"/>

    <VBox alignment="CENTER" spacing="0" maxWidth="380" styleClass="login-card">

        <!-- ============ VECTOR GEAR + MEDICAL CROSS LOGO ============
             Populated in LoginController.initialize() via IconFactory,
             since the gear's teeth are a computed polygon, not something
             practical to hand-write as static FXML. -->


        <VBox alignment="CENTER" spacing="2">
            <padding><Insets top="6"/></padding>
            <Label text="- HMS -" styleClass="login-brand"/>
            <Label text="Hospital Management System" styleClass="login-title" wrapText="true" textAlignment="CENTER"/>
            <Label text="Sign in to continue" styleClass="login-subtitle">
                <VBox.margin><Insets top="4"/></VBox.margin>
            </Label>
        </VBox>

        <VBox spacing="6" VBox.vgrow="NEVER">
            <padding><Insets top="26"/></padding>
            <Label text="Username" styleClass="muted"/>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-with-icon">
                <StackPane prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18">
                    <Circle radius="9" centerX="9" centerY="9" styleClass="field-icon-bg"/>
                    <Circle radius="3.4" centerX="9" centerY="7" styleClass="field-icon-fg"/>
                </StackPane>
                <TextField fx:id="usernameField" promptText="j.smith@hospital.org" styleClass="input-borderless" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="6">
            <padding><Insets top="14"/></padding>
            <Label text="Password" styleClass="muted"/>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-with-icon">
                <StackPane prefWidth="16" prefHeight="18" maxWidth="16" maxHeight="18">
                    <Arc centerX="8" centerY="8" radiusX="5" radiusY="5" startAngle="0" length="180"
                         type="OPEN" styleClass="field-icon-shackle-stroke" translateY="-2"/>
                    <Rectangle x="1" y="7" width="14" height="10" arcWidth="4" arcHeight="4" styleClass="field-icon-bg"/>
                    <Circle radius="1.6" centerX="8" centerY="12" styleClass="field-icon-fg"/>
                </StackPane>
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" promptText="Enter your password" onAction="#handleLogin" styleClass="input-borderless"/>
                    <TextField fx:id="passwordVisibleField" promptText="Enter your password" onAction="#handleLogin" styleClass="input-borderless" managed="false" visible="false"/>
                </StackPane>
                <Button fx:id="togglePasswordButton" styleClass="icon-toggle-button" onAction="#handleTogglePasswordVisibility"/>
            </HBox>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Label>

        <Button text="Sign In" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleLogin">
            <VBox.margin><Insets top="20"/></VBox.margin>
        </Button>

        <Label text="Default admin: admin / admin123" styleClass="muted" style="-fx-font-size: 10px;">
            <VBox.margin><Insets top="14"/></VBox.margin>
        </Label>

        <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword">
            <VBox.margin><Insets top="6"/></VBox.margin>
        </Hyperlink>

        <HBox alignment="CENTER" spacing="4">
            <padding><Insets top="2"/></padding>
            <Label text="Not Registered?" styleClass="muted" style="-fx-font-size: 12px;"/>
            <Hyperlink text="Create an Account" onAction="#handleCreateAccount" style="-fx-font-size: 12px;"/>
        </HBox>
    </VBox>

    <Label text="© 2026 Hospital Management System. All rights reserved." styleClass="muted"
           style="-fx-font-size: 11px;" StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin><Insets bottom="16"/></StackPane.margin>
    </Label>
</StackPane>
