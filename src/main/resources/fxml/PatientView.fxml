

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.PatientController" spacing="16">

    <!-- Top Filter & Search Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by name, ID, or phone..." prefWidth="240" onKeyReleased="#handleFilterChanged"/>

        <!-- Gender Filter -->
        <ComboBox fx:id="genderFilter" promptText="Gender" prefWidth="110" minWidth="100" onAction="#handleFilterChanged"/>

        <!-- Blood Group Filter -->
        <ComboBox fx:id="bloodGroupFilter" promptText="Blood Group" prefWidth="120" minWidth="110" onAction="#handleFilterChanged"/>

        <!-- Sort Dropdown -->
        <ComboBox fx:id="sortFilter" promptText="Sort By" prefWidth="150" minWidth="140" onAction="#handleFilterChanged"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" styleClass="muted"/>
        <Button text="Export to Excel" styleClass="btn-secondary" onAction="#handleExportExcel"/>
        <Button text="+ Add Patient" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <!-- Table View -->
    <TableView fx:id="patientTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCode" text="Patient ID" minWidth="85" prefWidth="95"/>
            <TableColumn fx:id="colName" text="Full Name" minWidth="140" prefWidth="160"/>
            <TableColumn fx:id="colGender" text="Gender" minWidth="75" prefWidth="85"/>
            <TableColumn fx:id="colAge" text="Age" minWidth="55" prefWidth="65"/>
            <TableColumn fx:id="colPhone" text="Phone" minWidth="115" prefWidth="125"/>
            <TableColumn fx:id="colBloodGroup" text="Blood" minWidth="65" prefWidth="75"/>
            <TableColumn fx:id="colRoom" text="Room" minWidth="85" prefWidth="95"/>
            <TableColumn fx:id="colActions" text="Actions" minWidth="230" prefWidth="240"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>

    <!-- Pagination Controls -->
    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="prevPageButton" text="Previous" styleClass="btn-secondary" onAction="#handlePrevPage"/>
        <Label fx:id="pageInfoLabel" styleClass="muted" text="Page 1 of 1"/>
        <Button fx:id="nextPageButton" text="Next" styleClass="btn-secondary" onAction="#handleNextPage"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Rows per page:" styleClass="muted"/>
        <ComboBox fx:id="pageSizeCombo" prefWidth="80" onAction="#handlePageSizeChanged"/>
    </HBox>
</VBox>