<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.RoomFormController" spacing="16" prefWidth="440">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label fx:id="dialogTitleLabel" text="Add Room" styleClass="section-title"/>
    <Label fx:id="formErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Room Code *" styleClass="muted"/>
            <TextField fx:id="roomCodeField" promptText="e.g. GW-102"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Room Type *" styleClass="muted"/>
            <ComboBox fx:id="roomTypeCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Capacity (beds) *" styleClass="muted"/>
            <Spinner fx:id="capacitySpinner" editable="true" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Floor" styleClass="muted"/>
            <TextField fx:id="floorField" promptText="e.g. 2nd Floor"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
            <Label text="Notes" styleClass="muted"/>
            <TextField fx:id="notesField"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Save Room" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
