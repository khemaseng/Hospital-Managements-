<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.MedicalRecordFormController" spacing="16" prefWidth="520">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label fx:id="dialogTitleLabel" text="Add Medical Record" styleClass="section-title"/>
    <Label fx:id="formErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Patient *" styleClass="muted"/>
            <ComboBox fx:id="patientCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Doctor *" styleClass="muted"/>
            <ComboBox fx:id="doctorCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
            <Label text="Diagnosis *" styleClass="muted"/>
            <TextArea fx:id="diagnosisField" prefRowCount="2" wrapText="true"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
            <Label text="Symptoms" styleClass="muted"/>
            <TextArea fx:id="symptomsField" prefRowCount="2" wrapText="true"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
            <Label text="Prescription" styleClass="muted"/>
            <TextArea fx:id="prescriptionField" prefRowCount="2" wrapText="true"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
            <Label text="Laboratory Result" styleClass="muted"/>
            <TextArea fx:id="labResultField" prefRowCount="2" wrapText="true"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <Label text="Doctor Notes" styleClass="muted"/>
            <TextArea fx:id="notesField" prefRowCount="2" wrapText="true"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Save Record" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
