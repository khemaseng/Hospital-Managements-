

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.AuditLogController" spacing="16">

    <!-- Top Filter & Search Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by user, action, details..." prefWidth="270" onKeyReleased="#handleFilterChanged"/>

        <!-- Action Type Filter -->
        <ComboBox fx:id="actionFilter" promptText="Action" prefWidth="170" minWidth="150" onAction="#handleFilterChanged"/>

        <!-- Sorting Dropdown -->
        <ComboBox fx:id="sortFilter" promptText="Sort By" prefWidth="160" minWidth="150" onAction="#handleFilterChanged"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" styleClass="muted"/>
        <Button text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
    </HBox>

    <!-- Table View -->
    <TableView fx:id="logTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colTime" text="Time" minWidth="160" prefWidth="170" styleClass="col-center"/>
            <TableColumn fx:id="colUser" text="User" minWidth="120" prefWidth="140"/>
            <TableColumn fx:id="colAction" text="Action" minWidth="140" prefWidth="160" styleClass="col-center"/>
            <TableColumn fx:id="colDetails" text="Details" minWidth="280" prefWidth="380"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>