


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.UserManagementController" spacing="16">

    <!-- Top Filter & Search Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search username, name, email..." prefWidth="250" onKeyReleased="#handleFilterChanged"/>

        <!-- Role Filter Dropdown -->
        <ComboBox fx:id="roleFilter" promptText="Role" prefWidth="150" minWidth="130" onAction="#handleFilterChanged"/>

        <!-- Status Filter Dropdown -->
        <ComboBox fx:id="statusFilter" promptText="Status" prefWidth="130" minWidth="120" onAction="#handleFilterChanged"/>

        <!-- Sorting Dropdown -->
        <ComboBox fx:id="sortFilter" promptText="Sort By" prefWidth="160" minWidth="150" onAction="#handleFilterChanged"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" styleClass="muted"/>
        <Button text="+ Add User" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <!-- Table View -->
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colUsername" text="Username" minWidth="110" prefWidth="130"/>
            <TableColumn fx:id="colFullName" text="Full Name" minWidth="150" prefWidth="180"/>
            <TableColumn fx:id="colRole" text="Role" minWidth="110" prefWidth="130" styleClass="col-center"/>
            <TableColumn fx:id="colEmail" text="Email" minWidth="160" prefWidth="200"/>
            <TableColumn fx:id="colStatus" text="Status" minWidth="100" prefWidth="110" styleClass="col-center"/>
            <TableColumn fx:id="colActions" text="Actions" minWidth="140" prefWidth="150" styleClass="col-center"/>
        </columns>
        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
    </TableView>
</VBox>