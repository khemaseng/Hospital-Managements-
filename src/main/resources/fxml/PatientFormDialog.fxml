<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hms.controller.PatientFormController" spacing="16" prefWidth="480">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label fx:id="dialogTitleLabel" text="Add Patient" styleClass="section-title"/>
    <Label fx:id="formErrorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Full Name *" styleClass="muted"/>
            <TextField fx:id="nameField"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Gender *" styleClass="muted"/>
            <ComboBox fx:id="genderCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Date of Birth" styleClass="muted"/>
            <DatePicker fx:id="dobPicker" maxWidth="Infinity" onAction="#handleDobChanged"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Age *" styleClass="muted"/>
            <Spinner fx:id="ageSpinner" editable="true" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Phone *" styleClass="muted"/>
            <TextField fx:id="phoneField"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Email" styleClass="muted"/>
            <TextField fx:id="emailField"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Blood Group" styleClass="muted"/>
            <ComboBox fx:id="bloodGroupCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Emergency Contact" styleClass="muted"/>
            <TextField fx:id="emergencyContactField"/>
        </VBox>

        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
            <Label text="Address" styleClass="muted"/>
            <TextArea fx:id="addressField" prefRowCount="2" wrapText="true"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Save Patient" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
